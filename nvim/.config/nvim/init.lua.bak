-- Neovim Config (init.lua) - Minimal Gruvbox con lazy.nvim

-- Bootstrap lazy.nvim (Plugin Manager)
local lazypath = vim.fn.stdpath("data") .. "/lazy/lazy.nvim"
if not vim.loop.fs_stat(lazypath) then
  vim.fn.system({
    "git",
    "clone",
    "--filter=blob:none",
    "https://github.com/folke/lazy.nvim.git",
    "--branch=stable", -- latest stable release
    lazypath,
  })
end
vim.opt.rtp:prepend(lazypath)

-- Opciones básicas de Neovim
vim.opt.number = true          -- Mostrar número de línea
vim.opt.relativenumber = true  -- Mostrar número relativo de línea
vim.opt.tabstop = 4            -- Tamaño de tabulación
vim.opt.softtabstop = 4        -- Tamaño de tabulación suave
vim.opt.shiftwidth = 4         -- Tamaño de indentación
vim.opt.expandtab = true       -- Usar espacios en lugar de tabs
vim.opt.smartindent = true     -- Indentación inteligente
vim.opt.wrap = false           -- No hacer wrap de líneas largas
vim.opt.swapfile = false       -- No crear archivos swap
vim.opt.backup = false         -- No crear archivos backup
vim.opt.undodir = vim.fn.stdpath("data") .. "/undodir" -- Directorio para historial de undo
vim.opt.undofile = true        -- Habilitar historial de undo persistente
vim.opt.hlsearch = true        -- Resaltar búsquedas
vim.opt.incsearch = true       -- Búsqueda incremental
vim.opt.termguicolors = true   -- Habilitar colores de terminal "true color"
vim.opt.scrolloff = 8          -- Mantener 8 líneas de contexto arriba/abajo del cursor
vim.opt.signcolumn = "yes"     -- Siempre mostrar columna de signos
vim.opt.updatetime = 50        -- Tiempo para escrituras
vim.opt.laststatus=3           -- Siempre mostrar statusline global
vim.cmd("set encoding=utf-8")  -- Asegurar encoding UTF-8

-- Configuración de lazy.nvim y plugins
require("lazy").setup({
  -- Tema Gruvbox Material
  {
    "sainnhe/gruvbox-material",
    priority = 1000, -- Asegura que se cargue pronto
    config = function()
      vim.g.gruvbox_material_background = 'hard' -- O 'medium', 'soft'
      vim.g.gruvbox_material_foreground = 'material'
      vim.g.gruvbox_material_enable_italic = 1
      vim.g.gruvbox_material_better_performance = 1

      -- Cargar el tema al iniciar
      vim.cmd([[colorscheme gruvbox-material]])
    end,
  },

  -- Puedes añadir otros plugins aquí si quieres, por ejemplo:
  -- { 'nvim-treesitter/nvim-treesitter', build = ':TSUpdate' },
  -- { 'nvim-telescope/telescope.nvim', tag = '0.1.x', dependencies = { 'nvim-lua/plenary.nvim' } },
  -- { 'neovim/nvim-lspconfig' },
  -- { 'hrsh7th/nvim-cmp', dependencies = { ... } }, -- Autocompletado
  -- { 'nvim-lualine/lualine.nvim', dependencies = { 'nvim-tree/nvim-web-devicons' } } -- Statusline bonita

})

-- Mensaje simple al iniciar (opcional)
-- print("Neovim listo con Gruvbox Material!")

-- Crear directorio de undo si no existe
if not vim.loop.fs_stat(vim.opt.undodir:get()) then
  vim.fn.mkdir(vim.opt.undodir:get(), "p")
end